#include<iostream>
using namespace std;

int main(){

    int n=4;
    int num=1;
    for(int i=1; i<=n; i++){ //outer loop for printing rows
        for(int j=i; j>0; j--){ //inner loop for printing every row columns
            cout << num;
            num++;
        }
        
        cout << endl;
    }

    return 0;
}
