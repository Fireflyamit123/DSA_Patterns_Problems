#include<iostream>
using namespace std;

int main(){

    int n=5;
     char ch = 'A';
    for(int i=1; i<=n; i++){ //outer loop for printing rows
       
        
        for(int j=1; j<=i; j++){ //inner loop for printing every row columns
           
            cout << ch;
            
        
        }
          ch++; // incresing in outerside because updating the char to next char
        cout << endl;
    }

    return 0;
}

