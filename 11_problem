#include<iostream>
using namespace std;

int main(){

    int n=4;
    
    for(int i=0; i<n; i++){ //outer loop for printing rows
        for(int j=0; j<i; j++){ //inner loop for printing every row columns
            cout << " ";
        }
        for(int j=0; j<n-i; j++){
            cout << (i+1);
        }
        
        cout << endl;
    }

    return 0;
}
